```gitignore
# Environment variables and secrets
.env
.env.*
!.env.example
!.env.template

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Test and coverage files
.pytest_cache/
.coverage
htmlcov/

# Python tooling
.mypy_cache/
.ruff_cache/

# Logs
*.log
logs/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Node.js dependencies and generated files
node_modules/
dist/
build/
coverage/

# Frontend environment files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Temporary files
*.tmp
*.temp

# Database dumps and backups
*.sql.gz
*.dump
*.bak

# Local application data
instance/
```
